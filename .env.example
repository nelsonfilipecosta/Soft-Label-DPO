# Copy to .env and fill in the values.

# Hugging Face access token with write permission (https://huggingface.co/settings/tokens)
HF_TOKEN=

# Weights & Biases API key (https://wandb.ai/authorize)
WANDB_API_KEY=

# W&B project that runs are logged to
WANDB_PROJECT=soft-label-dpo

# Optional on the GPU machine: put the model and dataset cache on the persistent volume
# HF_HOME=/workspace/hf_cache
